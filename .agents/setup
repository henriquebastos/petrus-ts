#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
node_version="$(cat .node-version)"

echo "Preparing Node $node_version"
SECONDS=0
if ! command -v node >/dev/null || [[ "$(node --version)" != "v$node_version" ]]; then
  case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64) arch=arm64 ;;
    *) echo "Unsupported Node architecture" >&2; exit 1 ;;
  esac
  download="$(mktemp -d)"
  trap 'rm -rf "$download"' EXIT
  archive="node-v$node_version-linux-$arch.tar.xz"
  curl --fail --silent --show-error --location "https://nodejs.org/dist/v$node_version/$archive" -o "$download/$archive"
  curl --fail --silent --show-error --location "https://nodejs.org/dist/v$node_version/SHASUMS256.txt" -o "$download/SHASUMS256.txt"
  (cd "$download"; grep "  $archive$" SHASUMS256.txt | sha256sum --check -)
  sudo tar -xJf "$download/$archive" -C /usr/local --strip-components=1
fi
echo "Node ready in ${SECONDS}s"

echo "Preparing pnpm"
SECONDS=0
package_manager="$(node -p 'JSON.parse(require("node:fs").readFileSync("package.json", "utf8")).packageManager')"
if ! command -v pnpm >/dev/null || [[ "$(pnpm --version)" != "${package_manager#pnpm@}" ]]; then
  sudo npm install --global "$package_manager"
fi
echo "pnpm ready in ${SECONDS}s"

echo "Installing locked dependencies"
SECONDS=0
pnpm install --frozen-lockfile
echo "Dependencies ready in ${SECONDS}s"

# The pre-push hook runs `pnpm periodic`, which takes about 50 minutes on a 2-CPU orb without Stryker's incremental
# file, and under a minute with a current one. Setup runs again on top of the last snapshot after each commit to main,
# and the snapshot keeps reports/, so setup keeps that file current for the next orb. A cold run stops after the time
# budget; Stryker saves the results so far on SIGINT, and the next setup continues from them. The marker names the
# commit of the last complete run, so commits that change no mutation input skip Stryker (scripts/mutation-inputs.ts).
echo "Warming Stryker's incremental file"
SECONDS=0
marker=reports/mutation/stryker-incremental.commit
head="$(git rev-parse HEAD)"
if [[ -f "$marker" && "$(node scripts/mutation-inputs.ts "$(cat "$marker")" "$head" 2>/dev/null || true)" == skip ]]; then
  echo "No mutation input changed since $(cat "$marker")"
else
  status=0
  timeout -s INT 600 node_modules/.bin/stryker run --reporters progress-append-only || status=$?
  case "$status" in
    0) echo "$head" > "$marker" ;;
    124) echo "Stopped at the 10-minute budget; the next setup continues from the saved results" ;;
    # A cache step must not fail setup: Amp would then publish no snapshot at all.
    *) echo "Stryker exited with $status; continuing without a complete incremental file" ;;
  esac
fi
echo "Stryker ready in ${SECONDS}s"
