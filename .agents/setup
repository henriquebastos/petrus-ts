#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
node_version="$(cat .node-version)"

echo "Preparing Node $node_version"
SECONDS=0
if ! command -v node >/dev/null || [[ "$(node --version)" != "v$node_version" ]]; then
  case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64) arch=arm64 ;;
    *) echo "Unsupported Node architecture" >&2; exit 1 ;;
  esac
  download="$(mktemp -d)"
  trap 'rm -rf "$download"' EXIT
  archive="node-v$node_version-linux-$arch.tar.xz"
  curl --fail --silent --show-error --location "https://nodejs.org/dist/v$node_version/$archive" -o "$download/$archive"
  curl --fail --silent --show-error --location "https://nodejs.org/dist/v$node_version/SHASUMS256.txt" -o "$download/SHASUMS256.txt"
  (cd "$download"; grep "  $archive$" SHASUMS256.txt | sha256sum --check -)
  sudo tar -xJf "$download/$archive" -C /usr/local --strip-components=1
fi
echo "Node ready in ${SECONDS}s"

echo "Preparing pnpm"
SECONDS=0
package_manager="$(node -p 'JSON.parse(require("node:fs").readFileSync("package.json", "utf8")).packageManager')"
if ! command -v pnpm >/dev/null || [[ "$(pnpm --version)" != "${package_manager#pnpm@}" ]]; then
  sudo npm install --global "$package_manager"
fi
echo "pnpm ready in ${SECONDS}s"

echo "Installing locked dependencies"
SECONDS=0
pnpm install --frozen-lockfile
echo "Dependencies ready in ${SECONDS}s"
