#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
# Knip's parser reserves 6 GiB of virtual memory without using that much RAM.
# Kernel settings must be restored when an orb wakes.
if [[ "$(cat /proc/sys/vm/overcommit_memory)" != 1 ]]; then
  sudo sysctl -w vm.overcommit_memory=1
fi
# Dependencies persist in the snapshot. Resume checks them without installing.
test "$(node --version)" = "v$(cat .node-version)"
test -d node_modules
# A package removed upstream leaves its ignored node_modules behind when the checkout updates. pnpm skips a folder
# with no package.json, so delete one that holds nothing else.
shopt -s nullglob
for folder in packages/*/ examples/*/; do
  if [[ "$(ls -A "$folder")" == node_modules ]]; then
    echo "Removing stale $folder"
    rm -rf "$folder"
  fi
done
