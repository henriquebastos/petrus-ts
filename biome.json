{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"linter": { "enabled": false },
	"assist": { "enabled": false },
	"formatter": { "enabled": true, "indentStyle": "tab", "indentWidth": 3, "lineWidth": 120 },
	"files": { "includes": ["**", "!fixtures/**", "!**/*.md", "!pnpm-lock.yaml"] },
	"overrides": [{ "includes": [".fallowrc.json"], "json": { "parser": { "allowComments": true } } }]
}
