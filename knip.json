{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["test/**/*.test.ts"],
			"project": ["*.ts", "scripts/**/*.ts", "test/**/*.ts"],
			"vitest": {
				"config": ["vitest.config.ts", "vitest.mutation.config.ts"]
			}
		},
		"packages/*": {
			"entry": ["test/**/*.test.{ts,tsx}"],
			"project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
		},
		"examples/*": {
			"entry": ["test/**/*.test.ts", "src/main.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts"]
		},
		"examples/classics": {
			"entry": ["test/**/*.test.{ts,tsx}", "viewer/main.tsx"],
			"ignoreBinaries": ["agent-browser"],
			"project": ["src/**/*.ts", "test/**/*.{ts,tsx}", "viewer/**/*.{ts,tsx}"]
		}
	}
}
