{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["test/**/*.test.ts"],
			"project": ["*.ts", "test/**/*.ts"],
			"vitest": {
				"config": ["vitest.config.ts", "vitest.mutation.config.ts"]
			}
		},
		"packages/*": {
			"entry": ["test/**/*.test.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts"]
		}
	}
}
