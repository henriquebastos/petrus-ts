# git writes one line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>. Fallow audits the
# commits since the remote sha, so the push is checked, not only uncommitted files. A new remote branch has
# an all-zero sha; then Fallow keeps its default base, local main. Only the first ref sets the base.
read -r _local_ref _local_sha _remote_ref remote_sha || true
if [ -n "$remote_sha" ] && [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
	export FALLOW_AUDIT_BASE="$remote_sha"
fi
# A surviving mutant fails the push: add a test, or mark an equivalent mutant with a reasoned Stryker disable comment.
pnpm inspect && pnpm periodic
