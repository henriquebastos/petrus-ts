{
	"name": "petrus-ts",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=26.8.2 <27"
	},
	"scripts": {
		"feedback": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run lint:deps && pnpm run lint:api && pnpm run lint:dead && pnpm run lint:md && pnpm run lint:docs && pnpm run test && pnpm run test:gates",
		"format": "biome format --write . && markdownlint-cli2 --fix",
		"format:check": "biome format .",
		"inspect": "pnpm run test && fallow audit",
		"lint": "eslint .",
		"lint:api": "node scripts/check-api.ts",
		"lint:dead": "knip",
		"lint:deps": "depcruise packages examples --config .dependency-cruiser.cjs && node scripts/check-entry-graphs.ts",
		"lint:md": "markdownlint-cli2",
		"lint:docs": "node scripts/check-docs.ts",
		"periodic": "stryker run",
		"prepare": "husky",
		"scale": "node scripts/scale.ts",
		"scale:state": "node scripts/check-scale-state.ts",
		"test": "vitest run --coverage",
		"test:gates": "vitest run --config vitest.gates.config.ts",
		"typecheck": "tsc -p packages/petri-net/tsconfig.json && tsc -p packages/runtime/tsconfig.json && tsc -p examples/comment-replies/tsconfig.json && tsc -p examples/classics/tsconfig.json && tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@fast-check/vitest": "0.5.0",
		"@microsoft/api-extractor": "7.59.4",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/typescript-checker": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@types/node": "26.6.5",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitest/coverage-istanbul": "4.1.12",
		"dependency-cruiser": "18.7.0",
		"eslint": "10.13.0",
		"fallow": "3.35.0",
		"fast-check": "4.10.2",
		"husky": "9.1.7",
		"knip": "6.42.1",
		"markdownlint-cli2": "0.24.0",
		"typebox": "1.3.27",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-eslint": "8.72.0",
		"vitest": "4.1.12"
	}
}
